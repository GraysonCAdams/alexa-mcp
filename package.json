{
  "name": "alexa-shopping-mcp",
  "version": "1.0.0",
  "description": "MCP server for Alexa Shopping List — manage your Amazon Alexa shopping list via Claude",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "alexa-shopping-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "npx tsx src/index.ts",
    "start": "node dist/index.js",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "alexa-remote2": "^8.0.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "patch-package": "^8.0.1",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "format": [
      "esm"
    ],
    "dts": true,
    "clean": true,
    "outDir": "dist",
    "external": []
  }
}
